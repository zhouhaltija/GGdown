<ContentDialog x:Class="GGdown.App.Views.Dialogs.FollowingListDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:GGdown.ViewModels"
               Title="关注列表"
               PrimaryButtonText="添加所选"
               CloseButtonText="关闭"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="False">
    <Grid MinWidth="460" MinHeight="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <AutoSuggestBox PlaceholderText="搜索用户名/昵称" QueryIcon="Find"
                        Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.VisibleItems, Mode=OneWay}"
                  SelectionMode="None" Margin="0,12,0,8" MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FollowingRowViewModel">
                    <Grid ColumnSpacing="8" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  IsEnabled="{x:Bind CanSelect}"
                                  VerticalAlignment="Center" MinWidth="0"/>
                        <Image Grid.Column="1" Source="{x:Bind AvatarUrl}" Width="32" Height="32"
                               VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}"/>
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="24" Height="24"
                          HorizontalAlignment="Left"/>
            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap"
                       Margin="36,0,0,0"/>
        </Grid>
    </Grid>
</ContentDialog>
