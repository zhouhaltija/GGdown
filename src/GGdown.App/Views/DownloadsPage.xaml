<Page x:Class="GGdown.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <Page.Resources>
        <!-- 任务卡片：进行中与最近完成共用；终态隐藏取消、显示失败原因与打开目录 -->
        <DataTemplate x:Key="JobCardTemplate" x:DataType="vm:JobCardViewModel">
            <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="4"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="4" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE896;" FontSize="18" Opacity="0.6"
                                  Visibility="{x:Bind conv:UiConv.ToInverseVisibility(HasPreview), Mode=OneWay}"/>
                        <Image Stretch="UniformToFill"
                               Source="{x:Bind conv:UiConv.ToImageSource(PreviewPath), Mode=OneWay}"
                               Visibility="{x:Bind conv:UiConv.ToVisibility(HasPreview), Mode=OneWay}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind KindBadge, Mode=OneWay}" FontSize="12"/>
                        </Border>
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind conv:UiConv.ToInverseVisibility(IsFinished), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Total==0 且 Running → 不确定态进度条；否则百分比 -->
                        <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100"
                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="12"
                                   Opacity="0.8" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="12" Opacity="0.8"
                               Visibility="{x:Bind conv:UiConv.ToVisibility(IsFinished), Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind conv:UiConv.ToVisibility(HasError), Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind CurrentFile, Mode=OneWay}" FontSize="12" Opacity="0.6"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind conv:UiConv.ToInverseVisibility(IsFinished), Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{x:Bind OpenFolderCommand}" Padding="8,4"
                            ToolTipService.ToolTip="打开所在文件夹" AutomationProperties.Name="打开所在文件夹"
                            Visibility="{x:Bind conv:UiConv.ToVisibility(CanOpenFolder), Mode=OneWay}">
                        <FontIcon Glyph="&#xE838;" FontSize="14"/>
                    </Button>
                    <Button Content="取消" Command="{x:Bind CancelCommand}"
                            Visibility="{x:Bind conv:UiConv.ToInverseVisibility(IsFinished), Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 新建下载 -->
            <RowDefinition Height="*"/>      <!-- 队列 -->
        </Grid.RowDefinitions>

        <!-- —— 新建下载：仅平台视图显示；全局视图只管队列 —— -->
        <StackPanel Margin="12,8,12,4" Padding="12" Spacing="8" CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowNewDownloadPanel), Mode=OneWay}">
            <!-- 链接/搜索：Twitter 的搜索框兼容推文与列表链接；其他站点为作品链接框 -->
            <Grid ColumnSpacing="8" Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsSearch), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="粘贴推文/列表链接，或输入搜索词（回车下载）"
                         AutomationProperties.Name="链接或搜索词"
                         Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"/>
                <Button Grid.Column="1" Content="下载" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind Vm.SearchCommand}"/>
            </Grid>
            <Grid ColumnSpacing="8" Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowPermalinkInput), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="{x:Bind Vm.PermalinkInputHint, Mode=OneWay}"
                         AutomationProperties.Name="作品链接"
                         Text="{x:Bind Vm.PermalinkInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnPermalinkKeyDown"/>
                <Button Grid.Column="1" Content="下载" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind Vm.DownloadPermalinkCommand}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsAccountContent), Mode=OneWay}">
                <TextBlock Text="我的账号：" VerticalAlignment="Center" Opacity="0.8"/>
                <ItemsControl ItemsSource="{x:Bind Vm.AccountActions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountContentActionViewModel">
                            <Button Content="{x:Bind Label}" Command="{x:Bind Command}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Padding="12,8" Opacity="0.8" TextWrapping="Wrap"
                   Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}"
                   Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}"/>

        <!-- 空状态 -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowEmptyState), Mode=OneWay}">
            <FontIcon Glyph="&#xE896;" FontSize="32" Opacity="0.5"/>
            <TextBlock Text="暂无下载任务" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Text="在「用户管理」里下载用户，或在上方粘贴链接" Opacity="0.7" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="12,4,12,12"
                      Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.ShowComingSoon), Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock Text="进行中" FontWeight="SemiBold" Margin="0,4,0,0"
                           Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasActive), Mode=OneWay}"/>
                <ItemsControl ItemsSource="{x:Bind Vm.Jobs, Mode=OneWay}"
                              ItemTemplate="{StaticResource JobCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,8,0,0" Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasFinished), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.FinishedHeader, Mode=OneWay}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <HyperlinkButton Content="清除记录" HorizontalAlignment="Right"
                                     Command="{x:Bind Vm.ClearFinishedCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind Vm.Finished, Mode=OneWay}"
                              ItemTemplate="{StaticResource JobCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
