<Page x:Class="GGdown.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 按钮行 -->
            <RowDefinition Height="*"/>      <!-- 任务卡片列表 -->
        </Grid.RowDefinitions>
        <StackPanel Spacing="8" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsAccountContent), Mode=OneWay}">
                <TextBlock Text="下载账号内容：" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{x:Bind Vm.AccountActions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountContentActionViewModel">
                            <Button Content="{x:Bind Label}" Command="{x:Bind Command}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsSearch), Mode=OneWay}">
                <TextBox PlaceholderText="搜索、推文或列表链接" MinWidth="280"
                         Text="{x:Bind Vm.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="搜索下载" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SearchCommand}"/>
            </StackPanel>
            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}" Opacity="0.8"/>
        </StackPanel>
        <TextBlock Grid.Row="0" Padding="12,8" Opacity="0.8" TextWrapping="Wrap"
                   Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}"
                   Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}"/>
        <ScrollViewer Grid.Row="1" Padding="12,0,12,12"
                      Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.ShowComingSoon), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.Jobs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobCardViewModel">
                        <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="4"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Padding="6,2" CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind KindBadge}" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- 控制器裁定 4：Total==0 且 Running → 不确定态（Ring）；否则 ProgressBar 百分比 -->
                                    <ProgressRing IsActive="{x:Bind IsIndeterminate, Mode=OneWay}" Width="20" Height="20"
                                                  Visibility="{x:Bind conv:UiConv.ToVisibility(IsIndeterminate), Mode=OneWay}"/>
                                    <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100"
                                                 MinWidth="200" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind CurrentFile, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 控制器裁定 3：取消按钮 IsFinished 时隐藏（bool → 页面 UiConv 转换，B3 模式） -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Width="48" Height="48" Stretch="UniformToFill"
                                       Source="{x:Bind conv:UiConv.ToImageSource(PreviewPath), Mode=OneWay}"
                                       Visibility="{x:Bind conv:UiConv.ToVisibility(HasPreview), Mode=OneWay}"/>
                                <Button Content="取消" Command="{x:Bind CancelCommand}"
                                        Visibility="{x:Bind conv:UiConv.ToInverseVisibility(IsFinished), Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
