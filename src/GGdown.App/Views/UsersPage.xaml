<Page x:Class="GGdown.App.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 列表或空状态 -->
            <RowDefinition Height="Auto"/>   <!-- 底部操作条 -->
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsSiteAvailable), Mode=OneWay}">
            <Button Content="添加用户" Command="{x:Bind Vm.ShowAddUserCommand}" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="关注列表" Command="{x:Bind Vm.ShowFollowingListCommand}"
                    IsEnabled="{x:Bind Vm.CanShowFollowingList, Mode=OneWay}"/>
            <AutoSuggestBox PlaceholderText="搜索用户名/昵称" QueryIcon="Find"
                             Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="240"/>
            <!-- F4：排序维度（SelectedIndex 0/1/2 → SortBy 字符串，映射在 code-behind OnSortChanged） -->
            <ComboBox SelectedIndex="0" Width="140" VerticalAlignment="Center"
                      SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="按末次下载"/>
                <ComboBoxItem Content="按下载次数"/>
                <ComboBoxItem Content="按添加时间"/>
            </ComboBox>
            <Button Content="全选" Command="{x:Bind Vm.SelectAllCommand}"/>
            <Button Content="取消全选" Command="{x:Bind Vm.DeselectAllCommand}"/>
            <Button Content="反选" Command="{x:Bind Vm.InvertSelectionCommand}"/>
            <Button Content="从剪贴板添加" Click="OnPasteFromClipboardClick"/>
            <Button Content="刷新资料" Command="{x:Bind Vm.RefreshProfilesCommand}"/>
        </StackPanel>
        <!-- 列表：DataGrid -->
        <controls:DataGrid x:Name="UsersGrid" Grid.Row="1" ItemsSource="{x:Bind Vm.Users, Mode=OneWay}"
                           Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowUserList), Mode=OneWay}"
                           AutoGenerateColumns="False" CanUserSortColumns="False"
                           IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                           GridLinesVisibility="Horizontal" Margin="12,0"
                           HorizontalGridLinesBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                           SelectionChanged="OnUsersGridSelectionChanged"
                           LoadingRow="OnUsersGridLoadingRow"
                           UnloadingRow="OnUsersGridUnloadingRow">
            <controls:DataGrid.Resources>
                <!-- 表格自带的选中/悬停用强调色高不透明度，会涂成两块深浅不一的灰。统一成很浅的一层。 -->
                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.12</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.16</x:Double>
                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.12</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.16</x:Double>
                <StaticResource x:Key="DataGridRowSelectedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
            </controls:DataGrid.Resources>
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Width="40" Header="">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MinWidth="0" MinHeight="0"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="用户" Width="320">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Height="52">
                                <Image Source="{Binding BannerUrl}" Stretch="UniformToFill" Opacity="0.28"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="4,0">
                                    <Image Source="{Binding AvatarUrl}" Width="36" Height="36"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding NewMediaText}" Foreground="#C42B1C" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Text="{Binding FollowersText}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Header="下载次数" Binding="{Binding DownloadCountText}" Width="90"/>
                <controls:DataGridTextColumn Header="末次下载" Binding="{Binding LastDownloadText}" Width="160"/>
                <controls:DataGridTemplateColumn Header="操作" Width="480">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadCommand}"
                                        IsEnabled="{Binding CanDownload}" Padding="8,2"/>
                                <Button Content="高光" Command="{Binding DownloadHighlightsCommand}" Padding="8,2"/>
                                <Button Content="目录" Command="{Binding OpenFolderCommand}" Padding="8,2"/>
                                <Button Content="主页" Command="{Binding OpenProfileCommand}" Padding="8,2"/>
                                <Button Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}" Padding="8,2"/>
                                <Button Content="{Binding SkipButtonText}" Command="{Binding ToggleSkipCommand}" Padding="8,2"/>
                                <Button Content="删除" Command="{Binding DeleteCommand}" Padding="8,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}">
            <TextBlock Text="{x:Bind Vm.SiteDisplayName, Mode=OneWay}" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}" HorizontalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="520"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowEmptyGuide), Mode=OneWay}">
            <TextBlock Text="暂无用户" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="①" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="导入 Cookie" Click="OnEmptyStateImportCookieClick"/>
                <TextBlock Text="选择 cookies.txt 验证账号" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="②" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="等待验证通过" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="③" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="关注列表" IsEnabled="{x:Bind Vm.HasAccount, Mode=OneWay}"
                        Click="OnEmptyStateFollowingListClick"/>
                <TextBlock Text="请先完成第 ① 步" VerticalAlignment="Center" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.HasAccount), Mode=OneWay}"/>
                <TextBlock Text="从关注里选择要添加的用户" VerticalAlignment="Center" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasAccount), Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
        <!-- 底部操作条：选中计数/按钮随 BottomBarVisible 显隐；StatusMessage 常显（放右侧）——
             若并入显隐容器，删除清空选中后"已删除 N 个用户"恰好被隐藏（偏离 brief 结构，见报告） -->
        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.BottomBarVisible), Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Vm.SelectedCountText, Mode=OneWay}"/>
                <Button Content="下载选中" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.DownloadSelectedCommand}"/>
                <Button Content="暂停选中" Command="{x:Bind Vm.SkipSelectedCommand}"/>
                <Button Content="恢复下载" Command="{x:Bind Vm.UnskipSelectedCommand}"/>
                <Button Content="删除选中" Command="{x:Bind Vm.DeleteSelectedCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.8"
                       Text="{x:Bind Vm.StatusMessage, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Page>
