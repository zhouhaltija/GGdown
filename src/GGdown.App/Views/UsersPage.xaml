<Page x:Class="GGdown.App.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 列表或空状态 -->
            <RowDefinition Height="Auto"/>   <!-- 底部操作条 -->
        </Grid.RowDefinitions>
        <!-- 工具栏：左侧为操作（主操作在前，次要入口收进下拉），右侧为查找/排序。
             原先 10 个控件挤一行、窄窗口会被截断。 -->
        <Grid Padding="12,8" ColumnSpacing="8"
              Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsSiteAvailable), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SplitButton Command="{x:Bind Vm.ShowAddUserCommand}" Style="{StaticResource AccentSplitButtonStyle}"
                             AutomationProperties.Name="添加用户">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14"/>
                        <TextBlock Text="添加用户"/>
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="从关注列表添加…" Command="{x:Bind Vm.ShowFollowingListCommand}"
                                            IsEnabled="{x:Bind Vm.CanShowFollowingList, Mode=OneWay}"
                                            Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsFollowingList), Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="从剪贴板添加" Click="OnPasteFromClipboardClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Command="{x:Bind Vm.IncrementalDownloadCommand}"
                        ToolTipService.ToolTip="为下载过的用户拉取新作品；有勾选时只处理勾选的用户"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsIncrementalDownload), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14"/>
                        <TextBlock Text="增量下载"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind Vm.RefreshProfilesCommand}"
                        ToolTipService.ToolTip="重新拉取头像、昵称、关注者数和作品数">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="{x:Bind Vm.RefreshProfilesText, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
                <Button Content="下载未下载用户" Command="{x:Bind Vm.DownloadNeverDownloadedCommand}"
                        ToolTipService.ToolTip="下载当前平台所有下载次数为 0 的用户；已跳过和下载中的用户会略过"/>
                <DropDownButton Content="选择" AutomationProperties.Name="选择">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="全选" Command="{x:Bind Vm.SelectAllCommand}"/>
                            <MenuFlyoutItem Text="取消全选" Command="{x:Bind Vm.DeselectAllCommand}"/>
                            <MenuFlyoutItem Text="反选" Command="{x:Bind Vm.InvertSelectionCommand}"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox PlaceholderText="搜索用户名/昵称" QueryIcon="Find"
                                AutomationProperties.Name="搜索用户"
                                Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="220"/>
                <!-- 排序维度（SelectedIndex 0/1/2 → SortBy 字符串，映射在 code-behind OnSortChanged） -->
                <ComboBox SelectedIndex="0" Width="130" VerticalAlignment="Center"
                          AutomationProperties.Name="排序"
                          SelectionChanged="OnSortChanged">
                    <ComboBoxItem Content="按末次下载"/>
                    <ComboBoxItem Content="按下载次数"/>
                    <ComboBoxItem Content="按添加时间"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <!-- 列表：DataGrid -->
        <controls:DataGrid x:Name="UsersGrid" Grid.Row="1" ItemsSource="{x:Bind Vm.Users, Mode=OneWay}"
                           Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowUserList), Mode=OneWay}"
                           AutoGenerateColumns="False" CanUserSortColumns="False"
                           IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                           GridLinesVisibility="Horizontal" Margin="12,0"
                           HorizontalGridLinesBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                           SelectionChanged="OnUsersGridSelectionChanged"
                           LoadingRow="OnUsersGridLoadingRow"
                           UnloadingRow="OnUsersGridUnloadingRow">
            <controls:DataGrid.Resources>
                <!-- 表格自带的选中/悬停用强调色高不透明度，会涂成两块深浅不一的灰。统一成很浅的一层。 -->
                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.12</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.16</x:Double>
                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.12</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.16</x:Double>
                <StaticResource x:Key="DataGridRowSelectedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundColor" ResourceKey="SystemAccentColor"/>
                <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent"/>
            </controls:DataGrid.Resources>
            <controls:DataGrid.Columns>
                <controls:DataGridTemplateColumn Width="40" Header="">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MinWidth="0" MinHeight="0"/>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTemplateColumn Header="用户" Width="*" MinWidth="280">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:UserRowViewModel">
                            <!-- 被跳过的用户整格淡化；置顶用户名前加图钉 -->
                            <Grid Height="52" Opacity="{x:Bind RowOpacity}">
                                <Image Source="{Binding BannerUrl}" Stretch="UniformToFill" Opacity="0.28"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="4,0">
                                    <Image Source="{Binding AvatarUrl}" Width="36" Height="36"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE718;" FontSize="12" VerticalAlignment="Center"
                                                      ToolTipService.ToolTip="已置顶"
                                                      Visibility="{x:Bind conv:UiConv.ToVisibility(IsPinned)}"/>
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding NewMediaText}" Foreground="#C42B1C" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"/>
                                        <TextBlock Text="{Binding FollowersText}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
                <controls:DataGridTextColumn Header="下载次数" Binding="{Binding DownloadCountText}" Width="90"/>
                <controls:DataGridTextColumn Header="末次下载" Binding="{Binding LastDownloadText}" Width="160"/>
                <!-- 操作：只留高频的「下载」，其余收进「更多」菜单（原先 7 个同权重按钮并排，删除也混在其中） -->
                <controls:DataGridTemplateColumn Header="操作" Width="170">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:UserRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadCommand}"
                                        IsEnabled="{Binding CanDownload}" Padding="12,3" MinWidth="72"/>
                                <Button Padding="8,4" ToolTipService.ToolTip="更多操作"
                                        AutomationProperties.Name="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutSubItem Text="下载内容"
                                                               Visibility="{x:Bind conv:UiConv.ToVisibility(ShowContentSelection)}">
                                                <MenuFlyoutItem Text="{x:Bind AllContentOptionText, Mode=OneWay}"
                                                                Command="{x:Bind SetAllContentCommand}"/>
                                                <MenuFlyoutItem Text="{x:Bind PrimaryContentOptionText, Mode=OneWay}"
                                                                Command="{x:Bind SetPrimaryContentCommand}"/>
                                                <MenuFlyoutItem Text="{x:Bind SecondaryContentOptionText, Mode=OneWay}"
                                                                Command="{x:Bind SetSecondaryContentCommand}"/>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="日期限制…" Command="{x:Bind EditDownloadSinceCommand}"
                                                            Visibility="{x:Bind conv:UiConv.ToVisibility(ShowDownloadSince)}"/>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="下载高光" Command="{x:Bind DownloadHighlightsCommand}"
                                                            Visibility="{x:Bind conv:UiConv.ToVisibility(ShowHighlights)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="打开下载目录" Command="{x:Bind OpenFolderCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="打开主页" Command="{x:Bind OpenProfileCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="{x:Bind PinButtonText}" Command="{x:Bind TogglePinCommand}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind SkipButtonText}" Command="{x:Bind ToggleSkipCommand}"
                                                            ToolTipService.ToolTip="跳过的用户不参与批量下载">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="删除…" Command="{x:Bind DeleteCommand}"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}">
            <TextBlock Text="{x:Bind Vm.SiteDisplayName, Mode=OneWay}" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}" HorizontalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="520"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowEmptyGuide), Mode=OneWay}">
            <TextBlock Text="暂无用户" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="①" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="导入 Cookie" Click="OnEmptyStateImportCookieClick"/>
                <TextBlock Text="选择 cookies.txt 验证账号" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="②" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="导入后自动验证账号" VerticalAlignment="Center" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.HasAccount), Mode=OneWay}"/>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasAccount), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="账号已就绪" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsFollowingList), Mode=OneWay}">
                <TextBlock Text="③" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="关注列表" IsEnabled="{x:Bind Vm.HasAccount, Mode=OneWay}"
                        Click="OnEmptyStateFollowingListClick"/>
                <TextBlock Text="请先完成第 ① 步" VerticalAlignment="Center" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.HasAccount), Mode=OneWay}"/>
                <TextBlock Text="从关注里选择要添加的用户" VerticalAlignment="Center" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasAccount), Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowManualAddGuide), Mode=OneWay}">
                <TextBlock Text="③" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="添加用户" Command="{x:Bind Vm.ShowAddUserCommand}"/>
                <TextBlock Text="输入用户主页链接或 sec_user_id" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
        </StackPanel>
        <!-- 底部条：勾选后出现批量操作；右侧常显用户总数。操作结果走窗口级浮动通知（StatusHub）。 -->
        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.BottomBarVisible), Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" Text="{x:Bind Vm.SelectedCountText, Mode=OneWay}"/>
                <Button Content="下载选中" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.DownloadSelectedCommand}"/>
                <Button Content="跳过" Command="{x:Bind Vm.SkipSelectedCommand}"
                        ToolTipService.ToolTip="跳过的用户不参与批量下载"/>
                <Button Content="取消跳过" Command="{x:Bind Vm.UnskipSelectedCommand}"/>
                <Button Content="删除…" Command="{x:Bind Vm.DeleteSelectedCommand}"/>
                <HyperlinkButton Content="取消选择" Command="{x:Bind Vm.DeselectAllCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7"
                       Text="{x:Bind Vm.UserCountText, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Page>
