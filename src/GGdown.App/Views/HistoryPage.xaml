<Page x:Class="GGdown.App.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 筛选行 -->
            <RowDefinition Height="*"/>      <!-- 历史列表 -->
            <RowDefinition Height="Auto"/>   <!-- 状态行 -->
        </Grid.RowDefinitions>
        <!-- 筛选行（brief Step 4）：用户 ComboBox（占位"全部用户"）+ 两个日期选择器 + 清除筛选按钮；
             三元组任一变更由 VM 自动触发 Refresh（无需刷新按钮）。
             日期控件用 CalendarDatePicker 而非 DatePicker：本机 WindowsAppSDK 1.6 XamlCompiler 对
             DatePicker 静默崩溃（MarkupCompilePass1 退出码 1、无错误输出，microsoft-ui-xaml#10027 同型故障；
             本任务实测任一页面放裸 DatePicker 即崩，CalendarDatePicker 正常），Date 同为 DateTimeOffset? 绑定 -->
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8">
            <ComboBox ItemsSource="{x:Bind Vm.FilterUsers, Mode=OneWay}"
                      SelectedItem="{x:Bind Vm.SelectedUserFilter, Mode=TwoWay}"
                      DisplayMemberPath="ScreenName"
                      PlaceholderText="全部用户" MinWidth="160" VerticalAlignment="Center"/>
            <CalendarDatePicker PlaceholderText="开始日期" Date="{x:Bind Vm.FromDate, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
            <CalendarDatePicker PlaceholderText="结束日期" Date="{x:Bind Vm.ToDate, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
            <Button Content="清除筛选" Command="{x:Bind Vm.ClearFiltersCommand}" VerticalAlignment="Center"/>
            <Button Content="{x:Bind Vm.GalleryToggleText, Mode=OneWay}" Command="{x:Bind Vm.ToggleGalleryCommand}"
                    VerticalAlignment="Center"/>
        </StackPanel>
        <GridView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}"
                  Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsGallery), Mode=OneWay}"
                  SelectionMode="None" Margin="12,0" Padding="0,0,0,12">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRowViewModel">
                    <Button Command="{x:Bind OpenFileCommand}" Padding="0" Background="Transparent" BorderThickness="0">
                        <Grid Width="168" Height="200" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Image Source="{x:Bind conv:UiConv.ToImageSource(FileUri)}" Stretch="UniformToFill"/>
                                    <TextBlock Text="▶" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.8"
                                               Visibility="{x:Bind conv:UiConv.ToVisibility(IsVideo)}"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Padding="4,6,4,0">
                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                <TextBlock Text="{x:Bind UserText}" Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <!-- 行模板：文件名/用户/查看原文（SourceUrl 非空才显示）/大小/时间/状态徽标/打开所在文件夹；
             行内命令绑行 VM 自身命令（回调委托回到宿主，WinUI 行模板无法绑定宿主命令，B3 模式） -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}"
                  Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.IsGallery), Mode=OneWay}"
                  SelectionMode="None" Margin="12,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRowViewModel">
                    <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="4"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="320"/>  <!-- 文件名 -->
                            <ColumnDefinition Width="*"/>                 <!-- 用户 -->
                            <ColumnDefinition Width="Auto"/>              <!-- 查看原文 -->
                            <ColumnDefinition Width="Auto"/>              <!-- 大小 -->
                            <ColumnDefinition Width="Auto"/>              <!-- 时间 -->
                            <ColumnDefinition Width="Auto"/>              <!-- 状态徽标 -->
                            <ColumnDefinition Width="Auto"/>              <!-- 打开所在文件夹 -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind FileName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind UserText}" VerticalAlignment="Center"
                                   Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                        <HyperlinkButton Grid.Column="2" Content="查看原文" Command="{x:Bind OpenSourceCommand}"
                                         Padding="4,0" VerticalAlignment="Center"
                                         Visibility="{x:Bind conv:UiConv.ToVisibility(HasSourceUrl), Mode=OneWay}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" VerticalAlignment="Center" Opacity="0.8"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind CreatedText}" VerticalAlignment="Center" Opacity="0.8"/>
                        <Border Grid.Column="5" Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind StatusText}" FontSize="12"/>
                        </Border>
                        <Button Grid.Column="6" Padding="8,4" VerticalAlignment="Center"
                                ToolTipService.ToolTip="打开所在文件夹" AutomationProperties.Name="打开所在文件夹"
                                Command="{x:Bind OpenContainingFolderCommand}">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
