<Page x:Class="GGdown.App.Views.Settings.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Enabled">
    <!-- Task 9：自原 SettingsPage「关于」节拆出（开源地址仍为定稿占位纯文本） -->
    <ScrollViewer Padding="12,0,12,12">
        <StackPanel Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="GGdown" Description="多站点媒体下载器">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.AppVersion, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                    <TextBlock Text="GitHub 仓库（Phase C 配置）" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </controls:SettingsCard>
            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}" Opacity="0.8" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
