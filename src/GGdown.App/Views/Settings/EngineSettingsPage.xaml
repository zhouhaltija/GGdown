<Page x:Class="GGdown.App.Views.Settings.EngineSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Enabled">
    <!-- Task 9：自原 SettingsPage「引擎」节拆出 -->
    <ScrollViewer Padding="12,0,12,12">
        <StackPanel Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="引擎" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="下载引擎" Description="{x:Bind Vm.EngineVersion, Mode=OneWay}">
                <Button Content="打开日志文件夹" Command="{x:Bind Vm.OpenLogsCommand}"/>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
