<Page x:Class="GGdown.App.Views.Settings.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      NavigationCacheMode="Enabled">
    <!-- Task 9：自原 SettingsPage「通用」节拆出（下载目录/并发） -->
    <ScrollViewer Padding="12,0,12,12">
        <StackPanel Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="通用" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="下载目录" Description="{x:Bind Vm.DownloadDirectory, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="浏览…" Command="{x:Bind Vm.BrowseDownloadDirectoryCommand}"/>
                    <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.SaveGeneralCommand}"/>
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="并发下载数" Description="同时进行的下载任务数，保存后立即生效">
                <NumberBox Value="{x:Bind Vm.Concurrency, Mode=TwoWay}" Minimum="1" SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Compact" Width="160"/>
            </controls:SettingsCard>
            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}" Opacity="0.8" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
