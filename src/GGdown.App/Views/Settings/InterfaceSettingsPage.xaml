<Page x:Class="GGdown.App.Views.Settings.InterfaceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:GGdown.App.Infrastructure"
      xmlns:vm="using:GGdown.ViewModels"
      NavigationCacheMode="Enabled">
    <!-- Task 9：界面设置——勾选平台栏显示哪些平台（spec §2.3），勾选即时生效 -->
    <ScrollViewer Padding="12,0,12,12">
        <StackPanel Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="界面" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="左侧平台栏显示哪些平台。不可用站点接入后自动出现。" Opacity="0.8" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{x:Bind Vm.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VisibleSiteItemViewModel">
                        <Grid Padding="12,8" Margin="0,0,0,4" ColumnSpacing="12" CornerRadius="4"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Path Width="20" Height="20" Stretch="Uniform"
                                      Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                      Data="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"
                                      Visibility="{x:Bind conv:UiConv.ToTwitterVisibility(SiteId), Mode=OneWay}"/>
                                <Image Source="{x:Bind conv:UiConv.ToSiteIcon(SiteId), Mode=OneWay}"
                                       Visibility="{x:Bind conv:UiConv.ToPixivVisibility(SiteId), Mode=OneWay}"/>
                                <TextBlock Text="♪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind conv:UiConv.ToDouyinVisibility(SiteId), Mode=OneWay}"/>
                                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="18"
                                          Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Available), Mode=OneWay}"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"/>
                                <TextBlock Text="即将支持" FontSize="12" Opacity="0.5"
                                           Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Available), Mode=OneWay}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsVisible, Mode=TwoWay}" OnContent="" OffContent=""
                                          IsEnabled="{x:Bind Available, Mode=OneWay}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
