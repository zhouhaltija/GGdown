<Window
    x:Class="GGdown.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GGdown.App.Infrastructure"
    xmlns:sites="using:GGdown.Sites"
    Title="GGdown">
    <!-- brief 原写法 Icon="&#xE716;" 在 WinUI3 运行时抛 XamlParseException（无法从裸 glyph 字符串创建 IconElement），
         改为显式 FontIcon 子元素，glyph 值不变 -->
    <!-- B8：全局通知行（InfoBar 承载 AccountInvalid 错误 / 任务完成提示），位于 NavigationView 之上，
         两行 Grid 使 InfoBar 独立于导航视图占顶部一条 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <InfoBar x:Name="NoticeBar"
                 Grid.Row="0"
                 IsOpen="False"
                 CloseButtonClick="NoticeBar_CloseButtonClick">
            <InfoBar.ActionButton>
                <!-- 仅错误（登录态失效）通知显示："去设置"导航 SettingsPage；成功通知时 Collapsed -->
                <Button x:Name="GoSettingsButton" Content="去设置" Click="GoSettingsButton_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="用户管理" Tag="users">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="历史" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 标题式站点切换：避免 PaneHeader 与汉堡按钮挤在同一行的 ComboBox -->
                <Button Grid.Row="0"
                        Margin="16,10,16,0"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind SiteSwitcher.SelectedDisplayName, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="11" Margin="0,2,0,0" Opacity="0.55"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="SiteFlyout" Placement="BottomEdgeAlignedLeft">
                            <ListView x:Name="SiteList"
                                      Width="268" MaxHeight="420"
                                      SelectionMode="Single"
                                      ItemsSource="{x:Bind SiteSwitcher.Sites}"
                                      SelectedItem="{x:Bind SiteSwitcher.Selected, Mode=TwoWay}"
                                      SelectionChanged="SiteList_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="MinHeight" Value="40"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="sites:SiteInfo">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="即将支持" FontSize="12" Opacity="0.5"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Available)}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Frame x:Name="ContentFrame" Grid.Row="1"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
