<Window
    x:Class="GGdown.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GGdown.App.Infrastructure"
    xmlns:vm="using:GGdown.ViewModels"
    Title="GGdown">
    <!-- Task 8：平台优先壳层——左 48px 平台图标栏 + 顶部页组标签行 + Frame；
         旧导航视图与标题式站点切换浮出层已移除（MainNavViewModel 驱动）。
         全局通知行（B8 InfoBar）保留在导航结构之上。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <InfoBar x:Name="NoticeBar"
                 Grid.Row="0"
                 IsOpen="False"
                 CloseButtonClick="NoticeBar_CloseButtonClick">
            <InfoBar.ActionButton>
                <!-- 仅错误（登录态失效）通知显示：跳当前平台的设置页；成功通知时 Collapsed -->
                <Button x:Name="GoSettingsButton" Content="去设置" Click="GoSettingsButton_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- —— 平台栏 —— -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView x:Name="PlatformList"
                          Grid.Row="0"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind Nav.Platforms, Mode=OneWay}"
                          SelectionChanged="PlatformList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlatformItemViewModel">
                            <StackPanel ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}" Spacing="2">
                                <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" FontSize="20"/>
                                <!-- 选中态小横条（ListViewItem 自带背景高亮之外的次级指示） -->
                                <Border Height="2" Width="16" CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind conv:UiConv.ToVisibility(IsSelected), Mode=OneWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="GlobalDownloadsButton"
                        Grid.Row="1" Click="GlobalDownloadsButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="0" MinHeight="44"
                        ToolTipService.ToolTip="全部平台的下载任务">
                    <Grid>
                        <FontIcon Glyph="&#xE896;" FontSize="20"/>
                        <Border x:Name="ActiveCountBadge"
                                Visibility="Collapsed"
                                MinWidth="16" MinHeight="16" CornerRadius="8"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0"
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                Padding="3,1">
                            <TextBlock x:Name="ActiveCountText" FontSize="10" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="GlobalSettingsButton"
                        Grid.Row="2" Click="GlobalSettingsButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="0" MinHeight="44"
                        ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="20"/>
                </Button>
            </Grid>
            <!-- —— 内容区：平台名 + 页组标签 + Frame —— -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,10,12,0">
                    <TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- 页组标签行：横向单选列表（TabView 容器绑定复杂度高，裁定用 ListView 胶囊行） -->
                    <ListView x:Name="PageTabs"
                              SelectionMode="Single"
                              ItemsSource="{x:Bind Nav.CurrentTabs, Mode=OneWay}"
                              SelectionChanged="PageTabs_SelectionChanged"
                              VerticalAlignment="Center">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="Padding" Value="12,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTabViewModel">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
