<Window
    x:Class="GalleryGUI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GalleryGUI">
    <!-- brief 原写法 Icon="&#xE716;" 在 WinUI3 运行时抛 XamlParseException（无法从裸 glyph 字符串创建 IconElement），
         改为显式 FontIcon 子元素，glyph 值不变 -->
    <NavigationView x:Name="Nav"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    OpenPaneLength="200"
                    SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="用户管理" Tag="users">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE716;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="下载" Tag="downloads">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="历史" Tag="history">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame"/>
    </NavigationView>
</Window>
