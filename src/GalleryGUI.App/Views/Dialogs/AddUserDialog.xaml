<ContentDialog x:Class="GalleryGUI.App.Views.Dialogs.AddUserDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="添加或下载"
               PrimaryButtonText="添加"
               CloseButtonText="取消"
               DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="380">
        <!-- TextChanged 即时校验：x:Bind TwoWay + UpdateSourceTrigger=PropertyChanged → VM.OnUserInputChanged → ValidateUserInput -->
        <TextBox PlaceholderText="{x:Bind Vm.InputHint, Mode=OneWay}"
                 Text="{x:Bind Vm.UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{x:Bind Vm.UserInputError, Mode=OneWay}"
                   Visibility="{x:Bind HasError(Vm.UserInputError), Mode=OneWay}"
                   Foreground="Red" TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
