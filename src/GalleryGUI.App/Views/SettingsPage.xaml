<Page x:Class="GalleryGUI.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:conv="using:GalleryGUI.App.Infrastructure"
      xmlns:vm="using:GalleryGUI.ViewModels"
      NavigationCacheMode="Enabled">
    <!-- B7：通用/账号/站点选项（OptionSchema 渲染）/引擎/关于 五组卡片（brief Step 4）。
         简单行用 SettingsCard；站点选项卡含 ItemsControl 多行动态渲染，用 Grid 卡
         （HistoryPage 卡片先例——SettingsCard 单行 Content 装不下） -->
    <ScrollViewer Padding="12,0,12,12">
        <StackPanel Spacing="8" MaxWidth="920" HorizontalAlignment="Stretch">
            <!-- —— 通用 —— -->
            <TextBlock Text="通用" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="下载目录" Description="{x:Bind Vm.DownloadDirectory, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="浏览…" Command="{x:Bind Vm.BrowseDownloadDirectoryCommand}"/>
                    <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.SaveGeneralCommand}"/>
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard Header="并发下载数" Description="同时进行的下载任务数，保存后立即生效">
                <NumberBox Value="{x:Bind Vm.Concurrency, Mode=TwoWay}" Minimum="1" SmallChange="1" LargeChange="1"
                           SpinButtonPlacementMode="Compact" Width="160"/>
            </controls:SettingsCard>
            <controls:SettingsCard Header="网络代理" Description="验证 Cookie、导入关注、下载均走此代理。本机 v2rayN：SOCKS 口（常见 10808）选 socks5h；HTTP 口（10809/7890）选 http。不要选 https。主机留空为直连。">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Bind Vm.ProxySchemeChoices}"
                              SelectedItem="{x:Bind Vm.ProxyScheme, Mode=TwoWay}"
                              MinWidth="110" VerticalAlignment="Center"/>
                    <TextBox PlaceholderText="主机" Text="{x:Bind Vm.ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140" VerticalAlignment="Center"/>
                    <NumberBox PlaceholderText="端口" Value="{x:Bind Vm.ProxyPort, Mode=TwoWay}"
                               Minimum="0" Maximum="65535" SmallChange="1"
                               SpinButtonPlacementMode="Compact" Width="120"/>
                    <TextBox PlaceholderText="用户名（可选）" Text="{x:Bind Vm.ProxyUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="100" VerticalAlignment="Center"/>
                    <TextBox PlaceholderText="密码（可选）" Text="{x:Bind Vm.ProxyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="100" VerticalAlignment="Center"/>
                    <Button Content="保存" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.SaveGeneralCommand}"/>
                </StackPanel>
            </controls:SettingsCard>

            <!-- —— 账号：无账号 → 导入按钮；有账号 → 昵称/@handle/状态徽标 + 重新验证/更换 Cookie —— -->
            <TextBlock Text="账号" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap"
                       Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}"/>
            <controls:SettingsCard Header="{x:Bind Vm.AccountSiteHeader, Mode=OneWay}" Description="导入浏览器导出的 cookies.txt 并自动验证"
                                   Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowAccountImport), Mode=OneWay}">
                <Button Content="导入 Cookie" Style="{StaticResource AccentButtonStyle}" Click="OnImportCookieClick"/>
            </controls:SettingsCard>
            <controls:SettingsCard Header="{x:Bind Vm.AccountTitle, Mode=OneWay}"
                                   Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowAccountCard), Mode=OneWay}">
                <controls:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Vm.AccountHandle, Mode=OneWay}"/>
                        <Border Padding="6,2" CornerRadius="4" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Vm.AccountStatusText, Mode=OneWay}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </controls:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="重新验证" Command="{x:Bind Vm.VerifyAccountCommand}"/>
                    <Button Content="更换 Cookie" Click="OnImportCookieClick"/>
                </StackPanel>
            </controls:SettingsCard>

            <!-- —— 站点选项：OptionItem 按 Kind 切换控件（Boolean→ToggleSwitch、Text/Choice→TextBox，
                 裁定 2：单模板 + x:Bind 函数可见性切换，简洁优先）—— -->
            <TextBlock Text="{x:Bind Vm.OptionsHeader, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"
                       Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsSiteAvailable), Mode=OneWay}"/>
            <Grid Padding="12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsSiteAvailable), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind Vm.TwitterOptions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionItemViewModel">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"/>
                                        <TextBlock Text="{x:Bind Key}" FontSize="12" Opacity="0.6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleSwitch IsOn="{x:Bind BoolValue, Mode=TwoWay}" OnContent="" OffContent=""
                                                      MinWidth="0" Margin="0" HorizontalAlignment="Right"
                                                      Visibility="{x:Bind conv:UiConv.ToVisibility(IsBoolean), Mode=OneWay}"/>
                                        <TextBox Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="280"
                                                 Visibility="{x:Bind conv:UiConv.ToVisibility(IsText), Mode=OneWay}"/>
                                        <ComboBox ItemsSource="{x:Bind Choices}"
                                                  SelectedItem="{x:Bind TextValue, Mode=TwoWay}"
                                                  MinWidth="140"
                                                  Visibility="{x:Bind conv:UiConv.ToVisibility(IsChoice), Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="保存站点选项" Command="{x:Bind Vm.SaveOptionsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- —— 引擎 —— -->
            <TextBlock Text="引擎" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="下载引擎" Description="{x:Bind Vm.EngineVersion, Mode=OneWay}">
                <Button Content="打开日志文件夹" Command="{x:Bind Vm.OpenLogsCommand}"/>
            </controls:SettingsCard>

            <!-- —— 关于：开源地址为定稿占位纯文本（不放死链，Phase C 配置）—— -->
            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <controls:SettingsCard Header="GalleryGUI" Description="X (Twitter) 媒体下载器">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Vm.AppVersion, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                    <TextBlock Text="GitHub 仓库（Phase C 配置）" VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
            </controls:SettingsCard>

            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}" Opacity="0.8" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
