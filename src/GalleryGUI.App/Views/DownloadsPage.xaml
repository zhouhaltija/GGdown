<Page x:Class="GalleryGUI.App.Views.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:GalleryGUI.App.Infrastructure"
      xmlns:vm="using:GalleryGUI.ViewModels"
      NavigationCacheMode="Enabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 按钮行 -->
            <RowDefinition Height="Auto"/>   <!-- 待下载清单 -->
            <RowDefinition Height="*"/>      <!-- 任务卡片列表 -->
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8"
                    Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.SupportsAccountContent), Mode=OneWay}">
            <TextBlock Text="下载账号内容：" VerticalAlignment="Center"/>
            <Button Content="喜欢" Command="{x:Bind Vm.DownloadLikesCommand}"/>
            <Button Content="书签" Command="{x:Bind Vm.DownloadBookmarksCommand}"/>
            <TextBlock Text="{x:Bind Vm.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
        </StackPanel>
        <TextBlock Grid.Row="0" Padding="12,8" Opacity="0.8" TextWrapping="Wrap"
                   Text="{x:Bind Vm.ComingSoonMessage, Mode=OneWay}"
                   Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.ShowComingSoon), Mode=OneWay}"/>
        <Border Grid.Row="1" Margin="12,0,12,8" Padding="12,8" CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.IsSiteAvailable), Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Vm.DownloadListHeader, Mode=OneWay}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="全部开始" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind Vm.StartDownloadListCommand}"
                            IsEnabled="{x:Bind Vm.HasDownloadList, Mode=OneWay}"/>
                </Grid>
                <TextBlock Text="暂无待下载用户，请在用户管理中加入清单" Opacity="0.7"
                           Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.HasDownloadList), Mode=OneWay}"/>
                <ScrollViewer MaxHeight="180"
                              Visibility="{x:Bind conv:UiConv.ToVisibility(Vm.HasDownloadList), Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind Vm.DownloadList, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadListItemViewModel">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.7"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="移出" Command="{x:Bind RemoveCommand}"
                                            Padding="8,2" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" Padding="12,0,12,12"
                      Visibility="{x:Bind conv:UiConv.ToInverseVisibility(Vm.ShowComingSoon), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.Jobs, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobCardViewModel">
                        <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="4"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Padding="6,2" CornerRadius="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind KindBadge}" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- 控制器裁定 4：Total==0 且 Running → 不确定态（Ring）；否则 ProgressBar 百分比 -->
                                    <ProgressRing IsActive="{x:Bind IsIndeterminate, Mode=OneWay}" Width="20" Height="20"
                                                  Visibility="{x:Bind conv:UiConv.ToVisibility(IsIndeterminate), Mode=OneWay}"/>
                                    <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100"
                                                 MinWidth="200" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind CurrentFile, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 控制器裁定 3：取消按钮 IsFinished 时隐藏（bool → 页面 UiConv 转换，B3 模式） -->
                            <Button Grid.Column="1" Content="取消" Command="{x:Bind CancelCommand}" VerticalAlignment="Center"
                                    Visibility="{x:Bind conv:UiConv.ToInverseVisibility(IsFinished), Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
